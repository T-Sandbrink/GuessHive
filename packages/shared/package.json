{
  "name": "@guesshive/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, types and constants for GuessHive (web + api)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@guesshive/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
