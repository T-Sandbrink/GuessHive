// GuessHive database schema (PLAN.md "Datamodel", task 1.3).
// The connection URL comes from prisma.config.ts (DATABASE_URL), not from here.
//
// Conventions (AGENTS.md §7, ADR 0004):
// - Surrogate keys are UUIDv7, generated by Postgres 18: @default(dbgenerated("uuidv7()")) @db.Uuid.
// - Every timestamp is timestamptz (UTC). Countries are ISO 3166-1 alpha-2, regions ISO 3166-2,
//   locales BCP 47.
// - Every foreign key and every feed filter/sort column has an index.
// - CHECK constraints and the per-language full-text indexes live in the migration SQL, since
//   Prisma cannot express them; they are listed above each model.
// - Better Auth's Account/Session/Verification tables arrive with task 2.1.
// - Revenue features (plan, premiumUntil, Subscription, Partner, EmbedKey, Sponsor) exist but are
//   off by default (phase 13).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum Plan {
  FREE
  PREMIUM
}

enum CommunityModeratorStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum ModerationTargetType {
  QUESTION
  COMMENT
  USER
  GROUP
  MEDIA
}

enum ModerationTrigger {
  AI_CHECK
  REPORTS
  SENSITIVE
  DARK_CORNER
}

enum ModerationCaseStatus {
  OPEN
  KEPT
  REMOVED
}

enum ModerationVerdict {
  KEEP
  REMOVE
  UNSURE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupResolutionStatus {
  PROPOSED
  DISPUTED
  FINAL
  ANNULLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELED
  PAST_DUE
}

enum PartnerKind {
  MEDIA
  BRAND
}

enum MediaKind {
  QUESTION
  OPTION
  AVATAR
  GROUP_AVATAR
  SPONSOR_LOGO
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AmbassadorStatus {
  APPLIED
  PROBATION
  ACTIVE
  REJECTED
  REVOKED
}

enum QuestionType {
  POLL_SINGLE
  POLL_MULTI
  THIS_OR_THAT
  PREDICTION_BINARY
  PREDICTION_CHOICE
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  CLOSED
  RESOLVED
  ANNULLED
  REJECTED
  ARCHIVED
}

enum QuestionScope {
  GLOBAL
  COUNTRY
  REGION
  GROUP
}

enum AiCheckResult {
  PASSED
  FLAGGED
  SKIPPED
}

enum AggregateDimension {
  ALL
  COUNTRY
  REGION
  AGE
  GENDER
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum ReactionTargetType {
  QUESTION
  COMMENT
}

enum BadgeExclusivity {
  NONE
  WACHTBIJ
  PREMIUM
}

enum MascotSlot {
  BODY
  EYES
  NOSE
  EARS
  HAIR
  BEARD
  OUTFIT
  ACCESSORY
  ACCENT
}

enum MascotUnlock {
  FREE
  LEVEL
  BADGE
}

enum ReportStatus {
  OPEN
  HANDLED
  DISMISSED
}

// ─── Users and settings ─────────────────────────────────────────────────────────────────────

// CHECK: streakFreezes BETWEEN 0 AND 2.
model User {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                 String            @unique
  emailVerified         Boolean           @default(false)
  /// Lowercase form of displayUsername, unique, so "Sam" and "sam" cannot both exist and lookups
  /// (e.g. /u/[username]) ignore case. A CHECK in the migration keeps it equal to
  /// lower(displayUsername). Names match Better Auth's username plugin (owner, 2026-11-20).
  username              String            @unique @db.VarChar(32)
  /// The username as the user typed it ("SamDeBij"); shown everywhere. Only ASCII letters, digits,
  /// `_` and `.`, starting with a letter or digit (USERNAME_PATTERN in @guesshive/shared; CHECK in
  /// the migration).
  displayUsername       String            @db.VarChar(32)
  avatarUrl             String?
  countryCode           String            @db.VarChar(2)
  regionCode            String?           @db.VarChar(6)
  /// Only for the age bucket and the 18+ check; never exposed (AGENTS.md §9).
  birthDate             DateTime?         @db.Date
  birthDateCorrectedAt  DateTime?         @db.Timestamptz(6)
  /// Values are defined with the onboarding UI (phase 3); free code until then.
  gender                String?           @db.VarChar(16)
  votesPublicByDefault  Boolean           @default(false)
  locale                String            @db.VarChar(10)
  timezone              String            @db.VarChar(64)
  role                  Role              @default(USER)
  trustScore            Int               @default(0)
  xp                    Int               @default(0)
  level                 Int               @default(1)
  winStreak             Int               @default(0)
  longestWinStreak      Int               @default(0)
  streakFreezes         Int               @default(0)
  lastStreakDate        DateTime?         @db.Date
  darkCornerEnabled     Boolean           @default(false)
  darkCornerConfirmedAt DateTime?         @db.Timestamptz(6)
  termsAcceptedAt       DateTime?         @db.Timestamptz(6)
  termsVersion          String?           @db.VarChar(32)
  /// 16+ confirmation at sign-up.
  ageConfirmedAt        DateTime?         @db.Timestamptz(6)
  status                UserStatus        @default(ACTIVE)
  suspendedUntil        DateTime?         @db.Timestamptz(6)
  profilePromptedAt     DateTime?         @db.Timestamptz(6)
  profileVisibility     ProfileVisibility @default(PUBLIC)
  plan                  Plan              @default(FREE)
  premiumUntil          DateTime?         @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  /// Start of the 14-day grace period; personal data is hard-deleted at deletedAt + 14 days.
  deletedAt             DateTime?         @db.Timestamptz(6)

  country Country @relation(fields: [countryCode], references: [code])
  region  Region? @relation(fields: [regionCode], references: [code])

  interests               UserInterest[]
  notificationPreferences NotificationPreference[]
  appSettingsUpdated      AppSetting[]
  communityModerator      CommunityModerator?
  moderationCasesDecided  ModerationCase[]
  moderationReviews       ModerationReview[]
  groupsOwned             Group[]
  fraudSignals            FraudSignal[]
  groupMemberships        GroupMember[]
  groupInvitesCreated     GroupInvite[]
  groupStakes             GroupStake[]
  groupResolutions        GroupResolution[]
  groupDisputeVotes       GroupDisputeVote[]
  subscriptions           Subscription[]
  mediaAssets             MediaAsset[]
  ambassadorships         Ambassador[]             @relation("AmbassadorUser")
  ambassadorsDecided      Ambassador[]             @relation("AmbassadorDecider")
  electionBlackouts       ElectionBlackout[]
  questionsAuthored       Question[]               @relation("QuestionAuthor")
  questionsResolved       Question[]               @relation("QuestionResolver")
  dailyQuestionsChosen    DailyQuestion[]
  votes                   Vote[]
  skips                   QuestionSkip[]
  forecasts               Forecast[]
  predictionScores        PredictionScore[]
  following               Follow[]                 @relation("Follower")
  followers               Follow[]                 @relation("Followee")
  agreementsAsA           Agreement[]              @relation("AgreementA")
  agreementsAsB           Agreement[]              @relation("AgreementB")
  comments                Comment[]
  reactions               Reaction[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  customization           UserCustomization?
  seasonalMascotsCreated  SeasonalMascot[]
  badges                  UserBadge[]
  xpEvents                XpEvent[]
  invitesSent             Invite[]                 @relation("Inviter")
  inviteUsed              Invite?                  @relation("InviteUsedBy")
  reports                 Report[]                 @relation("Reporter")
  reportsHandled          Report[]                 @relation("ReportHandler")
  auditLogs               AuditLog[]

  @@index([countryCode])
  @@index([regionCode])
  @@index([deletedAt])
}

model UserInterest {
  userId     String @db.Uuid
  categoryId String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model NotificationPreference {
  userId String  @db.Uuid
  type   String  @db.VarChar(64)
  push   Boolean @default(false)
  inApp  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

model FeatureFlag {
  key       String   @id @db.VarChar(64)
  enabled   Boolean  @default(false)
  rules     Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// Values are validated against the bounds registry in packages/shared (task 1.12).
model AppSetting {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

// ─── Moderation ─────────────────────────────────────────────────────────────────────────────

/// Community moderators ("Wachtbijen").
model CommunityModerator {
  userId          String                   @id @db.Uuid
  status          CommunityModeratorStatus @default(ACTIVE)
  termsVersion    String                   @db.VarChar(32)
  termsAcceptedAt DateTime                 @db.Timestamptz(6)
  reviewedCount   Int                      @default(0)
  agreedCount     Int                      @default(0)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModerationCase {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  targetType  ModerationTargetType
  targetId    String               @db.Uuid
  trigger     ModerationTrigger
  status      ModerationCaseStatus @default(OPEN)
  viewerCount Int?
  reportCount Int?
  decidedById String?              @db.Uuid
  decidedAt   DateTime?            @db.Timestamptz(6)
  reasonCode  String?              @db.VarChar(64)
  /// DSA statement of reasons.
  statement   String?
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)

  decidedBy User?              @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  reviews   ModerationReview[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([decidedById])
}

model ModerationReview {
  caseId    String            @db.Uuid
  userId    String            @db.Uuid
  verdict   ModerationVerdict
  reason    String?
  createdAt DateTime          @default(now()) @db.Timestamptz(6)

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
  @@index([userId])
}

/// Kept for 30 days, then deleted. Never a raw IP (AGENTS.md §9).
model FraudSignal {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  /// Salted hash of the IP address.
  ipHash     String   @db.VarChar(128)
  deviceHint String   @db.VarChar(64)
  ipCountry  String   @db.VarChar(2)
  day        DateTime @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per user, day, IP hash and device hint; written with upsert.
  @@unique([userId, day, ipHash, deviceHint])
  @@index([ipHash, day])
  @@index([createdAt])
}

// ─── Groups ─────────────────────────────────────────────────────────────────────────────────

// CHECK: seasonLengthMonths IN (1, 3, 6); maxMembers > 0.
model Group {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String    @db.VarChar(80)
  avatarUrl          String?
  description        String?
  /// Before a hard account delete, ownership moves to the longest-standing member, or the group is
  /// deleted when no member is left (task 11.2). No ON DELETE action, so a forgotten group blocks
  /// the delete instead of losing the group.
  ownerId            String    @db.Uuid
  maxMembers         Int       @default(25)
  seasonLengthMonths Int       @default(3)
  seasonStartsAt     DateTime  @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt          DateTime? @db.Timestamptz(6)

  owner     User          @relation(fields: [ownerId], references: [id])
  members   GroupMember[]
  invites   GroupInvite[]
  questions Question[]

  @@index([ownerId])
}

model GroupMember {
  groupId   String    @db.Uuid
  userId    String    @db.Uuid
  role      GroupRole @default(MEMBER)
  points    Int       @default(0)
  joinedAt  DateTime  @default(now()) @db.Timestamptz(6)
  /// Consent to share votes inside the group (AGENTS.md §9).
  consentAt DateTime  @db.Timestamptz(6)
  leftAt    DateTime? @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId     String    @db.Uuid
  code        String    @unique @db.VarChar(32)
  createdById String    @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdById])
}

// CHECK: amount > 0.
model GroupStake {
  questionId String  @db.Uuid
  userId     String  @db.Uuid
  optionId   String? @db.Uuid
  amount     Int
  /// Free-text stake agreed between friends; GuessHive never handles money.
  stakeNote  String? @db.VarChar(200)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  option   Option?  @relation(fields: [optionId], references: [id], onDelete: NoAction)

  @@id([questionId, userId])
  @@index([userId])
  @@index([optionId])
}

model GroupResolution {
  questionId       String                @id @db.Uuid
  proposedOptionId String                @db.Uuid
  /// Null once the proposer's account is hard-deleted; the proposal stays (task 11.2).
  proposedById     String?               @db.Uuid
  proposedAt       DateTime              @default(now()) @db.Timestamptz(6)
  disputeUntil     DateTime              @db.Timestamptz(6)
  status           GroupResolutionStatus @default(PROPOSED)

  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  proposedOption Option   @relation(fields: [proposedOptionId], references: [id], onDelete: NoAction)
  proposedBy     User?    @relation(fields: [proposedById], references: [id], onDelete: SetNull)

  @@index([proposedOptionId])
  @@index([proposedById])
  @@index([status, disputeUntil])
}

model GroupDisputeVote {
  questionId String   @db.Uuid
  userId     String   @db.Uuid
  optionId   String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  option   Option?  @relation(fields: [optionId], references: [id], onDelete: NoAction)

  @@id([questionId, userId])
  @@index([userId])
  @@index([optionId])
}

// ─── Revenue (phase 13, off by default) ─────────────────────────────────────────────────────

model Subscription {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String             @db.Uuid
  provider  String             @db.VarChar(32)
  status    SubscriptionStatus
  plan      Plan
  periodEnd DateTime           @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, periodEnd])
}

model Partner {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String      @db.VarChar(120)
  kind         PartnerKind
  contactEmail String
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)

  embedKeys EmbedKey[]
  sponsors  Sponsor[]
}

model EmbedKey {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId      String    @db.Uuid
  keyHash        String    @unique @db.VarChar(128)
  allowedOrigins String[]  @default([])
  revokedAt      DateTime? @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model Sponsor {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId   String  @db.Uuid
  name        String  @db.VarChar(120)
  logoAssetId String? @db.Uuid

  partner   Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  logoAsset MediaAsset? @relation("SponsorLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  questions Question[]

  @@index([partnerId])
  @@index([logoAssetId])
}

// ─── Media ──────────────────────────────────────────────────────────────────────────────────

/// Shown only after moderation (AGENTS.md §9).
model MediaAsset {
  id               String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null once the uploader's account is hard-deleted, so images of kept questions, options and
  /// sponsors stay. Task 11.2 deletes the user's own AVATAR assets (row and stored object) first; a
  /// CHECK in the migration blocks the user delete while an avatar would lose its owner.
  ownerId          String?     @db.Uuid
  url              String
  kind             MediaKind
  /// { nl, en }
  altText          Json        @default("{}")
  status           MediaStatus @default(PENDING)
  moderationLabels Json        @default("[]")
  hash             String      @db.VarChar(128)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)

  owner          User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sponsorLogos   Sponsor[]  @relation("SponsorLogo")
  questionImages Question[] @relation("QuestionImage")
  optionImages   Option[]   @relation("OptionImage")

  @@index([ownerId])
  @@index([status, createdAt])
  @@index([hash])
}

// ─── Places, categories, ambassadors ────────────────────────────────────────────────────────

model Country {
  /// ISO 3166-1 alpha-2.
  code           String    @id @db.VarChar(2)
  /// { nl, en }
  names          Json
  localEnabled   Boolean   @default(false)
  localEnabledAt DateTime? @db.Timestamptz(6)

  regions           Region[]
  users             User[]
  ambassadors       Ambassador[]
  electionBlackouts ElectionBlackout[]
  questions         Question[]
  seasonalMascots   SeasonalMascot[]
}

model Region {
  /// ISO 3166-2.
  code        String @id @db.VarChar(6)
  countryCode String @db.VarChar(2)
  /// { nl, en }
  names       Json

  country     Country      @relation(fields: [countryCode], references: [code])
  users       User[]
  ambassadors Ambassador[]
  questions   Question[]

  @@index([countryCode])
}

model Category {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug      String  @unique @db.VarChar(64)
  /// { nl, en }
  names     Json
  icon      String  @db.VarChar(64)
  sortOrder Int     @default(0)
  /// Special-category topic such as politics (AGENTS.md §9).
  sensitive Boolean @default(false)

  interests UserInterest[]
  questions Question[]
}

model Ambassador {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String           @db.Uuid
  countryCode     String           @db.VarChar(2)
  regionCode      String?          @db.VarChar(6)
  status          AmbassadorStatus @default(APPLIED)
  motivation      String
  appliedAt       DateTime         @default(now()) @db.Timestamptz(6)
  decidedById     String?          @db.Uuid
  decidedAt       DateTime?        @db.Timestamptz(6)
  probationEndsAt DateTime?        @db.Timestamptz(6)

  user      User    @relation("AmbassadorUser", fields: [userId], references: [id], onDelete: Cascade)
  country   Country @relation(fields: [countryCode], references: [code])
  region    Region? @relation(fields: [regionCode], references: [code])
  decidedBy User?   @relation("AmbassadorDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([countryCode, status])
  @@index([regionCode])
  @@index([decidedById])
}

// CHECK: endsAt > startsAt.
model ElectionBlackout {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  countryCode String   @db.VarChar(2)
  startsAt    DateTime @db.Timestamptz(6)
  endsAt      DateTime @db.Timestamptz(6)
  note        String
  /// Null once the admin account is hard-deleted (task 11.2).
  createdById String?  @db.Uuid

  country   Country @relation(fields: [countryCode], references: [code])
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([countryCode, startsAt])
  @@index([createdById])
}

// ─── Questions ──────────────────────────────────────────────────────────────────────────────

// CHECK: groupId IS NOT NULL exactly when scope = 'GROUP'; countryCode IS NOT NULL when scope is
// COUNTRY or REGION; regionCode IS NOT NULL when scope = 'REGION'; maxChoices >= 1;
// closesAt > opensAt.
model Question {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Short public id for URLs (ADR 0004); its format is enforced in the api, not here.
  shortId          String         @unique @db.VarChar(16)
  slug             String         @db.VarChar(120)
  type             QuestionType
  status           QuestionStatus @default(DRAFT)
  scope            QuestionScope
  countryCode      String?        @db.VarChar(2)
  regionCode       String?        @db.VarChar(6)
  groupId          String?        @db.Uuid
  darkCorner       Boolean        @default(false)
  /// Daily prediction (task 8.2c).
  isDaily          Boolean        @default(false)
  sponsorId        String?        @db.Uuid
  defaultLocale    String         @db.VarChar(10)
  /// Null once the author's account is hard-deleted ("deleted user"); the question stays (task 11.2).
  authorId         String?        @db.Uuid
  categoryId       String         @db.Uuid
  maxChoices       Int            @default(1)
  allowVoteChange  Boolean        @default(true)
  imageAssetId     String?        @db.Uuid
  opensAt          DateTime       @db.Timestamptz(6)
  closesAt         DateTime       @db.Timestamptz(6)
  resolvesAt       DateTime?      @db.Timestamptz(6)
  resolvedOptionId String?        @db.Uuid
  resolutionSource String?
  resolutionNote   String?
  resolvedAt       DateTime?      @db.Timestamptz(6)
  resolvedById     String?        @db.Uuid
  /// Proposed resolution (task 9.1c).
  proposedOptionId String?        @db.Uuid
  proposedSource   String?
  proposedAt       DateTime?      @db.Timestamptz(6)
  /// Drafts expire after 7 days.
  draftExpiresAt   DateTime?      @db.Timestamptz(6)
  aiCheck          AiCheckResult?
  aiCheckLabels    Json?
  /// Hidden pending moderation (task 9.4).
  hiddenAt         DateTime?      @db.Timestamptz(6)
  /// Denormalized; updated in the vote transaction.
  voteCount        Int            @default(0)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)

  country        Country?    @relation(fields: [countryCode], references: [code])
  region         Region?     @relation(fields: [regionCode], references: [code])
  group          Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sponsor        Sponsor?    @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  author         User?       @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category       Category    @relation(fields: [categoryId], references: [id])
  imageAsset     MediaAsset? @relation("QuestionImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  resolvedOption Option?     @relation("ResolvedOption", fields: [resolvedOptionId], references: [id], onDelete: NoAction)
  resolvedBy     User?       @relation("QuestionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  proposedOption Option?     @relation("ProposedOption", fields: [proposedOptionId], references: [id], onDelete: NoAction)

  translations     QuestionTranslation[]
  options          Option[]              @relation("QuestionOptions")
  dailyEntries     DailyQuestion[]
  votes            Vote[]
  skips            QuestionSkip[]
  forecasts        Forecast[]
  crowdSnapshots   CrowdSnapshot[]
  predictionScores PredictionScore[]
  resultAggregates ResultAggregate[]
  comments         Comment[]
  groupStakes      GroupStake[]
  groupResolution  GroupResolution?
  groupDispute     GroupDisputeVote[]

  @@index([status, scope, countryCode, opensAt])
  @@index([categoryId, status])
  @@index([groupId])
  @@index([darkCorner, status])
  @@index([isDaily, resolvesAt])
  @@index([regionCode])
  @@index([sponsorId])
  @@index([authorId, createdAt])
  @@index([imageAssetId])
  @@index([resolvedOptionId])
  @@index([resolvedById])
  @@index([proposedOptionId])
  @@index([status, closesAt])
}

// Full-text: one GIN index on to_tsvector(<language>, title) per locale (migration SQL).
model QuestionTranslation {
  questionId  String  @db.Uuid
  locale      String  @db.VarChar(10)
  title       String  @db.VarChar(200)
  description String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, locale])
}

model DailyQuestion {
  date       DateTime @db.Date
  /// 'GLOBAL' or a country code.
  scopeKey   String   @db.VarChar(8)
  questionId String   @db.Uuid
  chosenById String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenBy User?    @relation(fields: [chosenById], references: [id], onDelete: SetNull)

  @@id([date, scopeKey])
  @@index([questionId])
  @@index([chosenById])
}

model Option {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  questionId   String  @db.Uuid
  position     Int
  imageAssetId String? @db.Uuid

  question   Question    @relation("QuestionOptions", fields: [questionId], references: [id], onDelete: Cascade)
  imageAsset MediaAsset? @relation("OptionImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  translations      OptionTranslation[]
  resolvedFor       Question[]          @relation("ResolvedOption")
  proposedFor       Question[]          @relation("ProposedOption")
  voteChoices       VoteChoice[]
  forecasts         Forecast[]
  forecastHistory   ForecastHistory[]
  crowdSnapshots    CrowdSnapshot[]
  resultAggregates  ResultAggregate[]
  groupStakes       GroupStake[]
  groupResolutions  GroupResolution[]
  groupDisputeVotes GroupDisputeVote[]

  @@unique([questionId, position])
  @@index([imageAssetId])
}

model OptionTranslation {
  optionId String @db.Uuid
  locale   String @db.VarChar(10)
  label    String @db.VarChar(120)

  option Option @relation(fields: [optionId], references: [id], onDelete: NoAction)

  @@id([optionId, locale])
}

// ─── Votes and forecasts ────────────────────────────────────────────────────────────────────

/// One vote per user per question (AGENTS.md §8). userId becomes null when the account is
/// hard-deleted; the vote stays for the aggregates, anonymised (task 11.2).
model Vote {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  questionId    String   @db.Uuid
  userId        String?  @db.Uuid
  isPublic      Boolean  @default(false)
  /// Fraud handling (task 9.16).
  countsFrom    DateTime @default(now()) @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  snapCountry   String   @db.VarChar(2)
  snapRegion    String?  @db.VarChar(6)
  snapAgeBucket String?  @db.VarChar(16)
  snapGender    String?  @db.VarChar(16)

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  choices  VoteChoice[]

  @@unique([questionId, userId])
  @@index([userId])
}

model VoteChoice {
  voteId   String @db.Uuid
  optionId String @db.Uuid

  vote   Vote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  option Option @relation(fields: [optionId], references: [id], onDelete: NoAction)

  @@id([voteId, optionId])
  @@index([optionId])
}

model QuestionSkip {
  questionId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
  @@index([userId])
}

// CHECK: probability BETWEEN 1 AND 99.
model Forecast {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  questionId  String   @db.Uuid
  /// Null once the forecaster's account is hard-deleted, like Vote, so the crowd forecast and
  /// other users' scores stay stable (owner, 2026-11-20).
  userId      String?  @db.Uuid
  optionId    String?  @db.Uuid
  probability Int
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  option   Option?           @relation(fields: [optionId], references: [id], onDelete: NoAction)
  history  ForecastHistory[]

  @@unique([questionId, userId])
  @@index([userId])
  @@index([optionId])
}

// CHECK: probability BETWEEN 1 AND 99.
model ForecastHistory {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  forecastId  String   @db.Uuid
  optionId    String?  @db.Uuid
  probability Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  option   Option?  @relation(fields: [optionId], references: [id], onDelete: NoAction)

  @@index([forecastId, createdAt])
  @@index([optionId])
}

// CHECK: probability BETWEEN 0 AND 100.
model CrowdSnapshot {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  questionId      String   @db.Uuid
  optionId        String?  @db.Uuid
  probability     Float
  forecasterCount Int
  takenAt         DateTime @default(now()) @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   Option?  @relation(fields: [optionId], references: [id], onDelete: NoAction)

  @@index([questionId, takenAt])
  @@index([optionId])
}

model PredictionScore {
  questionId String   @db.Uuid
  userId     String   @db.Uuid
  brier      Float
  crowdBrier Float
  points     Int
  computedAt DateTime @default(now()) @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
  @@index([userId, computedAt])
}

/// dimensionValue is '' for ALL. Small groups are filtered by k-anonymity in the api.
model ResultAggregate {
  questionId     String             @db.Uuid
  optionId       String             @db.Uuid
  dimension      AggregateDimension
  dimensionValue String             @db.VarChar(16)
  count          Int                @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   Option   @relation(fields: [optionId], references: [id], onDelete: NoAction)

  @@id([questionId, optionId, dimension, dimensionValue])
  @@index([optionId])
}

// ─── Social ─────────────────────────────────────────────────────────────────────────────────

// CHECK: followerId <> followeeId.
model Follow {
  followerId String   @db.Uuid
  followeeId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
}

/// One row per pair, stored with userAId < userBId (CHECK).
model Agreement {
  userAId     String   @db.Uuid
  userBId     String   @db.Uuid
  sharedCount Int      @default(0)
  agreeCount  Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  userA User @relation("AgreementA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("AgreementB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
}

/// Rendered as plain text (AGENTS.md §8). showChoice is opt-in per comment.
model Comment {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  questionId String        @db.Uuid
  /// Null once the commenter's account is hard-deleted; replies by others stay. A CHECK in the
  /// migration only allows that when `body` is '' and `deletedAt` is set, so task 11.2 must wipe the
  /// text first and no other delete path can keep it.
  userId     String?       @db.Uuid
  parentId   String?       @db.Uuid
  body       String        @db.VarChar(2000)
  showChoice Boolean       @default(false)
  status     CommentStatus @default(VISIBLE)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  editedAt   DateTime?     @db.Timestamptz(6)
  deletedAt  DateTime?     @db.Timestamptz(6)

  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([questionId, createdAt])
  @@index([userId])
  @@index([parentId])
}

/// Polymorphic target: no foreign key on targetId; the service checks it exists.
model Reaction {
  id         String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String             @db.Uuid
  targetType ReactionTargetType
  targetId   String             @db.Uuid
  emoji      String             @db.VarChar(16)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId, emoji])
  @@index([targetType, targetId])
}

model Notification {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @db.Uuid
  type      String    @db.VarChar(64)
  payload   Json
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Gamification and personalization ───────────────────────────────────────────────────────

model Badge {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug         String           @unique @db.VarChar(64)
  /// { nl, en }
  names        Json
  /// { nl, en }
  descriptions Json
  icon         String           @db.VarChar(64)
  /// Earned title { nl, en }, if this badge grants one.
  title        Json?
  exclusiveTo  BadgeExclusivity @default(NONE)

  awards  UserBadge[]
  titleOf UserCustomization[]
}

model UserCustomization {
  userId            String   @id @db.Uuid
  mascotLook        Json?
  mascotName        String?  @db.VarChar(32)
  useOwnBee         Boolean  @default(false)
  useBeeAsAvatar    Boolean  @default(false)
  /// null means the app default (accent, start tab and text size are set in task 8b.4).
  accent            String?  @db.VarChar(32)
  startTab          String?  @db.VarChar(32)
  hiddenCategoryIds String[] @default([]) @db.Uuid
  textSize          String?  @db.VarChar(16)
  compactCards      Boolean  @default(false)
  celebrations      Json     @default("{}")
  featuredBadgeIds  String[] @default([]) @db.Uuid
  titleBadgeId      String?  @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleBadge Badge? @relation(fields: [titleBadgeId], references: [id], onDelete: SetNull)

  @@index([titleBadgeId])
}

model MascotItem {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slot        MascotSlot
  key         String       @db.VarChar(64)
  unlock      MascotUnlock @default(FREE)
  /// Level number or badge slug, depending on unlock.
  unlockValue String?      @db.VarChar(64)
  sortOrder   Int          @default(0)

  @@unique([slot, key])
}

// CHECK: endsAt > startsAt.
model SeasonalMascot {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String   @db.VarChar(64)
  look        Json
  countryCode String?  @db.VarChar(2)
  startsAt    DateTime @db.Timestamptz(6)
  endsAt      DateTime @db.Timestamptz(6)
  /// Null once the admin account is hard-deleted (task 11.2).
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  country   Country? @relation(fields: [countryCode], references: [code])
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startsAt, endsAt])
  @@index([countryCode])
  @@index([createdById])
}

model UserBadge {
  userId    String   @db.Uuid
  badgeId   String   @db.Uuid
  awardedAt DateTime @default(now()) @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([badgeId])
}

model XpEvent {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid
  type      String   @db.VarChar(64)
  amount    Int
  refId     String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Invite {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  inviterId String    @db.Uuid
  code      String    @unique @db.VarChar(32)
  usedById  String?   @unique @db.Uuid
  usedAt    DateTime? @db.Timestamptz(6)

  inviter User  @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  usedBy  User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([inviterId])
}

// ─── Reports and audit ──────────────────────────────────────────────────────────────────────

/// Polymorphic target: no foreign key on targetId; the service checks it exists.
model Report {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null once the reporter's account is hard-deleted; the report and its outcome stay (task 11.2).
  reporterId  String?              @db.Uuid
  targetType  ModerationTargetType
  targetId    String               @db.Uuid
  reason      String               @db.VarChar(64)
  status      ReportStatus         @default(OPEN)
  handledById String?              @db.Uuid
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)

  reporter  User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId, status])
  @@index([status, createdAt])
  @@index([handledById])
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(64)
  targetType String   @db.VarChar(32)
  /// A uuid or a string key (AppSetting.key, Country.code, …).
  targetId   String   @db.VarChar(64)
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}
