# Copy to apps/api/.env (gitignored). Validated at startup by src/env.ts.

# development | test | production. Unset means production (fail safe); keep development locally.
NODE_ENV=development

# Interface and port the api listens on. Keep 127.0.0.1 locally; containers use 0.0.0.0.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent (unset: info, or silent in tests)
LOG_LEVEL=info

# PostgreSQL (docker compose service "postgres", see the root README).
DATABASE_URL=postgresql://guesshive:guesshive@localhost:5440/guesshive

# Redis (docker compose service "redis"); rediss:// for TLS. Default: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Run the BullMQ background workers inside the api process: true | false (default: true).
# false keeps the queues (jobs can still be added) but processes nothing.
WORKERS_ENABLED=true

# Secret key for hashing client IPs in rate limits (min. 32 characters). Optional locally;
# required in production. Generate one with: openssl rand -base64 48
# IP_HASH_SECRET=

# Better Auth (task 2.1). Secret signs session cookies and encrypts OAuth tokens (min. 32
# characters); optional locally, required in production (openssl rand -base64 48). Rotating it
# signs everyone out.
# BETTER_AUTH_SECRET=
# Public origin of the web app; the browser reaches /api/auth/* there through the SvelteKit
# proxy. Default: http://localhost:5173. Required (https) in production.
# BETTER_AUTH_URL=http://localhost:5173

# Optional, local development only: email of the admin created by `pnpm --filter api db:seed`.
# Must use a reserved domain (.test, .example, .localhost); the seed only runs against localhost.
# SEED_ADMIN_EMAIL=admin@guesshive.test
