# Root environment for repo tooling. Copy to .env (gitignored) and fill in.
# App-specific variables live in apps/*/.env.example.

# Folder that receives a copy of PLAN.md after every commit (scripts/sync-drive.mjs).
# Leave empty to disable.
GUESSHIVE_DRIVE_DIR=

# docker compose overrides (optional). Defaults are local-only and bound to 127.0.0.1.
# POSTGRES_PORT=5440
# POSTGRES_TEST_PORT=5441
# REDIS_PORT=6379
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# S3_PORT=8333
# S3_ACCESS_KEY=guesshive
# S3_SECRET_KEY=guesshive-dev-only
